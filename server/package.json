{
  "name": "hrms-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "knex migrate:latest",
    "rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "demo": "node src/db/demo.js",
    "setup": "knex migrate:latest && knex seed:run",
    "smoke": "node scripts/smoke.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:api": "node ../tests/run.mjs",
    "holidays": "node scripts/seed-holidays.js",
    "db:create": "node scripts/create-db.js",
    "setup:mysql": "node scripts/create-db.js && knex migrate:latest && knex seed:run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
