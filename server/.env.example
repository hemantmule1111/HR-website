# Copy to .env and fill in. Never commit or share the real .env.

PORT=4000
NODE_ENV=production

# Public address people use to open the site (no trailing slash). Same origin as the API is recommended.
CLIENT_ORIGIN=https://hr.yourcompany.com
# Set to true once the site is served over HTTPS
FORCE_HTTPS=false

# --- MySQL (XAMPP default: user root, empty password) ---
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hrms
# For a no-install local trial instead, use: DB_CLIENT=sqlite3 and SQLITE_FILE=./hrms.sqlite

# Long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

COMPANY_TZ=Asia/Kolkata

# First Super Admin, created by `npm run setup:mysql`. Change the password after first login.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=ChangeThisNow!123

# Email me when the server hits an unexpected error (needs the email settings below). Empty = no emails.
ERROR_ALERT_EMAIL=

# Email (welcome, password reset, notifications). Leave SMTP_HOST empty to send nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false # true for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=WorkPilot
# Address people open from email links, e.g. https://hr.yourdomain.com
APP_URL=
# Write emails to server/mail-outbox.log instead of sending (local testing)
MAIL_LOG=false
MAIL_FROM=hr@yourcompany.com
